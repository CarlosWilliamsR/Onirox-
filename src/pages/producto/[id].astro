---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { allProducts } from '../../data/products';
import ProductDetailClient from '../../components/ProductDetailClient';
import ColorSelector from '../../components/ColorSelector';

// Generar las rutas para cada producto automáticamente
export async function getStaticPaths() {
  return allProducts.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

// Obtener los datos del producto actual
const { product } = Astro.props;
---

<Layout title={`${product.name} | ONIROX`}>
  <Navbar />

  <!-- Main Product Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-12 py-8 sm:py-12 md:py-16 lg:py-24 xl:py-32">
    <!-- Back Link -->
    <a 
      href="/" 
      class="inline-flex items-center gap-2 sm:gap-2.5 text-xs sm:text-sm font-normal text-black dark:text-white hover:text-zinc-700 dark:hover:text-zinc-300 mb-6 sm:mb-8 md:mb-12 transition-all duration-300 rounded-full px-3 sm:px-4 py-2 sm:py-2.5 hover:bg-zinc-100/50 dark:hover:bg-zinc-800/50 active:scale-95"
    >
      <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      <span class="hidden xs:inline">VOLVER A LA COLECCIÓN</span>
      <span class="xs:hidden">VOLVER</span>
    </a>

    <!-- Product Grid: 2 columnas (Desktop) / 1 columna (Móvil) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 sm:gap-12 md:gap-16 lg:gap-20 xl:gap-24">
      
      <!-- Columna Izquierda: Galería de Imágenes -->
      <div class="relative">
        <!-- Imagen Principal (Frente) -->
        <div class="relative w-full aspect-square overflow-hidden bg-zinc-50 dark:bg-zinc-900 rounded-2xl sm:rounded-3xl shadow-soft dark:shadow-none transition-shadow duration-500 hover:shadow-medium dark:hover:shadow-large">
          <img 
            id="main-product-image"
            src="/images/products/placeholder.svg"
            alt={`${product.name} - Vista frontal`}
            class="w-full h-full object-cover transition-all duration-700 ease-out hover:scale-105"
            transition:name={`image-${product.id}`}
            onerror="this.src='/images/products/placeholder.svg'"
          />
        </div>
        
        <!-- Galería de Imágenes: Frente y Espalda -->
        {product.images.length > 1 && (
          <div class="grid grid-cols-2 gap-2 sm:gap-3 mt-3 sm:mt-4">
            {product.images.map((image, index) => {
              const isFront = image.includes('-frente');
              const label = isFront ? 'Frente' : 'Espalda';
              return (
                <div class="relative aspect-square overflow-hidden bg-zinc-50 group cursor-pointer rounded-2xl shadow-soft transition-all duration-300 hover:shadow-medium">
                  <img 
                    src="/images/products/placeholder.svg"
                    alt={`${product.name} - ${label}`}
                    class="w-full h-full object-cover transition-all duration-500 group-hover:scale-110 rounded-2xl"
                    onerror="this.src='/images/products/placeholder.svg'"
                  />
                  <div class="absolute bottom-0 left-0 right-0 bg-black/70 backdrop-blur-sm text-white text-xs font-extrabold uppercase tracking-wider py-2 px-3 text-center opacity-0 group-hover:opacity-100 transition-all duration-300 rounded-b-2xl">
                    {label}
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>

      <!-- Columna Derecha: Información del Producto -->
      <div class="flex flex-col space-y-4 sm:space-y-6 md:space-y-8">
        
        <!-- Título con transición -->
        <h1 
          class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-ultrabold text-black dark:text-white mb-3 sm:mb-4 uppercase tracking-[-0.03em] leading-tight animate-fade-in-up"
          transition:name={`title-${product.id}`}
        >
          {product.name}
        </h1>

        <!-- Precio Grande -->
        <p class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold text-black dark:text-white mb-4 sm:mb-6 md:mb-8 tracking-tight animate-fade-in-up" style="animation-delay: 0.1s">
          ${product.price.toFixed(2)}
        </p>

        <!-- Story (Narrativa ecológica) - Bloque destacado -->
        {product.story && (
          <div class="bg-zinc-50/80 dark:bg-zinc-900/80 backdrop-blur-sm border-l-4 border-black dark:border-white/20 p-4 sm:p-6 md:p-8 mb-6 sm:mb-8 rounded-r-xl sm:rounded-r-2xl animate-fade-in-up shadow-soft dark:shadow-none" style="animation-delay: 0.2s">
            <p class="text-sm sm:text-base md:text-lg font-normal text-black dark:text-zinc-200 leading-relaxed tracking-tight">
              {product.story}
            </p>
          </div>
        )}

        <!-- Sección DETALLES: Lista limpia como en el PDF -->
        <div class="border-t border-zinc-200/50 dark:border-zinc-800/50 pt-6 sm:pt-8 animate-fade-in-up" style="animation-delay: 0.3s">
          <h3 class="text-xs font-extrabold text-black dark:text-white uppercase tracking-widest mb-4 sm:mb-6 text-zinc-500 dark:text-zinc-400">
            DETALLES:
          </h3>
          
          <ul class="space-y-3 sm:space-y-4 text-sm sm:text-base font-normal text-black dark:text-zinc-200">
            <li class="flex items-start">
              <span class="font-extrabold mr-2">Franela:</span>
              <span>Unisex</span>
            </li>
            <li class="flex items-start">
              <span class="font-extrabold mr-2">Marca:</span>
              <span>ONIROX</span>
            </li>
            <li class="flex items-start">
              <span class="font-extrabold mr-2">Tela:</span>
              <span>{product.fabric}</span>
            </li>
            <li class="flex items-start">
              <span class="font-extrabold mr-2">Tallas:</span>
              <span>{product.availableSizes.join(', ')}.</span>
            </li>
          </ul>
        </div>

        <!-- Sección COLORES: Grid de colores disponibles como en el PDF -->
        <div class="border-t border-zinc-200/50 dark:border-zinc-800/50 pt-6 sm:pt-8 animate-fade-in-up" style="animation-delay: 0.4s">
          <h3 class="text-xs font-extrabold text-black dark:text-white uppercase tracking-widest mb-4 sm:mb-6 text-zinc-500 dark:text-zinc-400">
            COLORES:
          </h3>
          
          <ColorSelector product={product} client:load />
        </div>

        <!-- Botón Grande Negro: Añadir al Carrito -->
        <ProductDetailClient product={product} client:load />
      </div>
    </div>
  </section>

  <Footer />
</Layout>
